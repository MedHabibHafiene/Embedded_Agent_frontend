# Copy this file to .env and adjust values.

# Base URL of the FastAPI backend. Leave empty in development: requests go
# same-origin and the Vite dev proxy (vite.config.ts) forwards /api, /health
# and /generate-and-flash to the backend. Set only when serving a production
# build from a CORS-whitelisted origin, e.g. http://localhost:8000
VITE_API_BASE_URL=

# Request timeout in milliseconds (generating + compiling can take minutes).
VITE_REQUEST_TIMEOUT=300000
